{
  "name": "website-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite dev --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "prod": "node ./build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test-vite && npm run test-storybook",
    "test:coverage": "npm run test-vite:coverage && npm run test-storybook:coverage",
    "test-vite": "vitest --run",
    "test-vite:coverage": "npm run test-vite -- --coverage",
    "test-vite:watch": "vitest --watch",
    "test-storybook": "test-storybook --browsers firefox",
    "test-storybook:coverage": "npm run test-storybook -- --coverage",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && npm run test-storybook:coverage\"",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@storybook/addon-a11y": "^9.1.4",
    "@storybook/addon-coverage": "^2.0.0",
    "@storybook/addon-links": "^9.1.4",
    "@storybook/jest": "^0.2.3",
    "@storybook/sveltekit": "^9.1.4",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/testing-library": "^0.2.2",
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "autoprefixer": "^10.4.19",
    "axe-playwright": "^2.0.1",
    "bits-ui": "^2.16.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-storybook": "^9.1.4",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "postcss": "^8.4.38",
    "postcss-load-config": "^5.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^9.1.17",
    "svelte": "^5.53.6",
    "svelte-check": "^4.0.0",
    "svelte-icons-pack": "^3.1.3",
    "svelte-preprocess": "^6.0.0",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.6.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^1.4.0",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "lucide-svelte": "^0.525.0",
    "mode-watcher": "^0.3.0",
    "storybook-addon-pseudo-states": "^9.1.4",
    "tailwind-merge": "^2.3.0",
    "tailwind-variants": "^0.2.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
