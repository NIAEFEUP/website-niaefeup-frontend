# NIddle API (https://github.com/NIAEFEUP/NIddle), used to fetch the events.
# Copy this file to `.env.local` and fill in the values.
# If either value is empty, or NIddle is unreachable / has no events,
# the site falls back to src/lib/data/api/events/list.json.

# Base URL of the NIddle API, without the `/api` suffix.
PUBLIC_NIDDLE_API_URL=http://localhost:3001

# UUID of the NI association in NIddle (only its events are shown).
PUBLIC_NIDDLE_ASSOCIATION_ID=
